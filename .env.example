# -----------------------------------------------------------------------------
# RSSHub 环境配置文件模板
# 请将此文件重命名为 .env，并修改为您自己的安全密钥
# -----------------------------------------------------------------------------

# RSSHub 的访问密钥，用于保护您的 RSSHub 实例不被滥用。
# 请务必修改为一个复杂且安全的随机字符串！
# 前端面板中的 /api/cookiecloud 等鉴权可能也会依赖此密钥或生成 MD5
ACCESS_KEY=your_secure_access_key_here

# YouTube Data API v3 密钥
# 申请地址: https://console.cloud.google.com/
# 如果不需要抓取 YouTube 相关的 RSS 可以留空
YOUTUBE_KEY=your_youtube_api_key_here

# CookieCloud ���� (���ڱ����Զ�ͬ��)
COOKIECLOUD_SERVER=https://cookiecloud.example.com
COOKIECLOUD_UUID=your_uuid_here
COOKIECLOUD_PASSWORD=your_password_here
BILIBILIUID=12345678

# Gost Proxy Configuration
# Example: -L=:8888 -F=rr://username:password@ip:port?max_fails=3&fail_timeout=30s -bypass=/bypass.txt
GOST_COMMAND=-L=:8888
